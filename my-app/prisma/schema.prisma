generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Medicine {
  id                String   @id @default(uuid())
  tradeName         String
  barcode           BigInt?
  internationalName String?
  dosage            String?
  no                Int?
  dosageForm        String?
  conditionsOfIssue Boolean?
  country           String?
  createdAt         DateTime @default(now())
}
