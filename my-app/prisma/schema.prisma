generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Medicine {
  id                             String   @id @default(uuid())
  tradeNameMN                    String?
  tradeNameEN                    String?
  barcode                        BigInt?  @unique
  internationalName              String?
  dosage                         String?
  no                             Int?
  dosageForm                     String?
  conditionsOfIssue              Boolean?
  country                        String?
  createdAt                      DateTime @default(now())
  registered                     String?
  indicationsForUse              String?
  prohibitionsPrecautions        Json?
  sideEffects                    String?
  interactionWithOtherDrugs      Json?
  useDuringPregnancyAndLactation String?
  adult                          Json?
  child                          Json?
  image                          String?
}

model user {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}